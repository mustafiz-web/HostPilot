# Host Pilot — Frontend Environment Variables
# Copy this file to .env.production or set in your hosting platform (Vercel, Netlify, Cloudflare Pages, etc.)

# Backend API Base URL (HTTPS in production)
# Example: https://api.hostpilot.example.com/api/v1
VITE_API_BASE_URL=https://api.hostpilot.example.com/api/v1
