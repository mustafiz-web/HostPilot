# Host Pilot — Backend Environment Variables (Production & Development Reference)
# IMPORTANT: Never commit actual secrets or production passwords to version control!

# Server Runtime Configuration
PORT=5000
NODE_ENV=production

# MySQL Database Connection String (Prisma)
# Example: mysql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?sslmode=require
DATABASE_URL="mysql://hostpilot_user:strong_password@localhost:3306/host_pilot_prod"

# Security & Authentication Secrets (Generate using: openssl rand -base64 32)
JWT_SECRET="replace-with-a-cryptographically-secure-random-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="replace-with-a-cryptographically-secure-random-cookie-secret"

# Allowed Frontend Client Origin (CORS & Cookie Domain)
# Example: https://hostpilot.example.com
CLIENT_URL="https://hostpilot.example.com"

# Application Settings & Localization
APP_TIMEZONE="Asia/Dhaka"
LOG_LEVEL="info"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
